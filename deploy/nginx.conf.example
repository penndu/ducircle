# Nginx 反向代理示例
# 用法：放到 /etc/nginx/conf.d/ducircle.conf，修改 server_name 与证书路径

upstream ducircle {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name 你的域名;
    # certbot 验证用，其余流量一律走 HTTPS
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name 你的域名;

    ssl_certificate     /etc/letsencrypt/live/你的域名/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/你的域名/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;

    # 文章全文与摘要可能较大，放宽响应体但限制请求体
    client_max_body_size 4m;

    # API 路径不缓存，保证抓到新文章
    location /api/ {
        proxy_pass http://ducircle;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        add_header Cache-Control "no-store";
    }

    # 后台与展示页
    location / {
        proxy_pass http://ducircle;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # 限流：与应用的 Redis 限流双保险，防的是网络层洪水
    limit_req_zone $binary_remote_addr zone=ducircle_api:10m rate=20r/s;

    location ~ ^/v1/ {
        limit_req zone=ducircle_api burst=40 nodelay;
        proxy_pass http://ducircle;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 静态资源可以放心长缓存
    location /static/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript;
    gzip_min_length 1024;
}