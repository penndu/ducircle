# ---- 基础 ----
# 用于签发 Session 与 API Key 哈希。
# 换这个值会让所有已登录用户掉线，部署后不要随意改。
SECRET_KEY=请用 openssl rand -base64 48 生成
DEBUG=false
BASE_URL=https://ducircle.dusays.com

# ---- 数据库 ----
# 1Panel 托管的 MySQL。这里填容器服务名，不是 127.0.0.1。
MYSQL_HOST=1Panel-mysql-wQr4
MYSQL_PORT=3306
MYSQL_DATABASE=ducircle
MYSQL_USER=ducircle
MYSQL_PASSWORD=请填写数据库密码

# ---- Redis ----
# 有密码时格式为 redis://:密码@主机:6379/0
REDIS_URL=redis://:请填写Redis密码@1Panel-redis-29uO:6379/0

# ---- 抓取 ----
CRAWL_TIMEOUT=30
CRAWL_RETRIES=3
MAX_CONCURRENT_PER_USER=10
MAX_CONCURRENT_GLOBAL=50
MAX_POSTS_PER_SITE=10
OUTDATE_CLEAN_DAYS=90
RESPECT_ROBOTS=true
CRAWL_MIN_INTERVAL=1800

# ---- 限流 ----
RATE_LIMIT_QPS=5
RATE_LIMIT_BURST=15

# ---- AI 摘要 ----
# 平台额度需要配置平台 Key；留空则用户只能用自己填的 Key。
AI_ENABLED=true
AI_PLATFORM_PROVIDER=siliconflow
AI_PLATFORM_API_KEY=
AI_PLATFORM_MODEL=Qwen/Qwen3-8B
AI_DAILY_QUOTA=10

# ---- 调度 ----
SCHEDULER_ENABLED=true
CRAWL_CRON=0 0,6,12,18 * * *
CLEANUP_CRON=0 3 * * *
STATS_CRON=0 4 * * *
AI_CRON=0 * * * *
