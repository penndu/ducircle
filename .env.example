# ---- 基础 ----
SECRET_KEY=请替换为足够长的随机字符串
DEBUG=false
BASE_URL=https://你的域名

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=请设置root密码
MYSQL_DATABASE=fcircle
MYSQL_USER=fcircle
MYSQL_PASSWORD=请设置应用密码
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- 抓取 ----
CRAWL_TIMEOUT=30
CRAWL_RETRIES=3
MAX_CONCURRENT_PER_USER=10
MAX_CONCURRENT_GLOBAL=50
MAX_POSTS_PER_SITE=10
OUTDATE_CLEAN_DAYS=90
RESPECT_ROBOTS=true
CRAWL_MIN_INTERVAL=1800

# ---- 限流 ----
RATE_LIMIT_QPS=5
RATE_LIMIT_BURST=15

# ---- AI 摘要 ----
AI_ENABLED=true
AI_PLATFORM_PROVIDER=siliconflow
AI_PLATFORM_API_KEY=留空则关闭平台AI摘要
AI_PLATFORM_MODEL=Qwen/Qwen3-8B
AI_DAILY_QUOTA=10

# ---- 调度 ----
SCHEDULER_ENABLED=true
CRAWL_CRON=0 0,6,12,18 * * *
CLEANUP_CRON=0 3 * * *
STATS_CRON=0 4 * * *